{
  "name": "task-tracker",
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://muataz94.github.io/task-tracker",
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint build.mjs frontend/api.js frontend/mobile-nav.js frontend/notifications.js playwright.config.js tests/**/*.js tests/**/*.mjs",
